# Local env
.env
!.env.example

# Build output and dev tools
/bin/
/coverage.out
/third_party/

# Dataset (downloaded and built by `make data`; never commit)
/data/

# Python
__pycache__/
*.pyc
tools/.venv/
.pytest_cache/
.ruff_cache/

# Model artifacts (exported by tools/models and tools/training)
*.onnx
# Tiny test models (tools/training/testmodels.py)
!internal/providers/scorer/onnx/testdata/*.onnx
deploy/triton/model_repository/*/1/*
!deploy/triton/model_repository/*/1/model.py
!deploy/triton/model_repository/*/1/.gitkeep
deploy/triton/model_repository/SOURCES.json
# Learned scorers (make train): Triton's rank model and the training outputs
deploy/triton/model_repository/rank_gbdt_v1/
tools/training/out/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
