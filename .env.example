# Copy to .env (make does this automatically). Dev-only defaults; never reuse in production.

# --- Compose: host ports ---
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
OPENSEARCH_HOST_PORT=9200
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
KAFKA_HOST_PORT=19092
REDPANDA_ADMIN_HOST_PORT=9644
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
TRITON_HTTP_HOST_PORT=8000
TRITON_GRPC_HOST_PORT=8001
TRITON_METRICS_HOST_PORT=8002

# --- Compose: infra settings ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=searchengine
MYSQL_USER=search
MYSQL_PASSWORD=search
OPENSEARCH_HEAP=512m
CLICKHOUSE_DB=searchengine
CLICKHOUSE_USER=search
CLICKHOUSE_PASSWORD=search
KAFKA_TOPIC_CATALOG=catalog.product.v1
KAFKA_TOPIC_EVENTS=search.events.v1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_IMAGES=catalog-images
S3_BUCKET_MODELS=tenant-models
S3_BUCKET_UPLOADS=catalog-uploads

# --- Migrations (golang-migrate URLs) ---
MYSQL_MIGRATE_URL='mysql://search:search@tcp(localhost:3307)/searchengine?multiStatements=true'
CLICKHOUSE_MIGRATE_URL='clickhouse://localhost:9000?username=search&password=search&database=searchengine&x-multi-statement=true&x-migrations-table-engine=MergeTree'

# --- Application ---
APP_ENV=dev
LOG_LEVEL=info
SEARCH_API_ADDR=:8080
CONTROL_API_ADDR=:8081
SHUTDOWN_TIMEOUT=15s

MYSQL_DSN='search:search@tcp(localhost:3307)/searchengine?parseTime=true'
REDIS_ADDR=localhost:6379
OPENSEARCH_URL=http://localhost:9200
QDRANT_ADDR=localhost:6334
KAFKA_BROKERS=localhost:19092
CLICKHOUSE_ADDR=localhost:9000
TRITON_GRPC_ADDR=localhost:8001
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1

JWT_ISSUER=http://localhost:8081
JWKS_URL=http://localhost:8081/.well-known/jwks.json
# Base64 32-byte key for the dev AES-256-GCM SecretStore. Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1jaGFuZ2UtbWUtMzI=

ONNXRUNTIME_LIB=./third_party/onnxruntime/lib/libonnxruntime.so

# Empty disables trace export; set to http://localhost:4317 with `make up-obs`.
OTEL_EXPORTER_OTLP_ENDPOINT=
