name: "bge_text_pre"
backend: "python"
max_batch_size: 0
input [ { name: "INPUT_TEXT", data_type: TYPE_STRING, dims: [ -1 ] } ]
output [
  { name: "input_ids", data_type: TYPE_INT64, dims: [ -1, -1 ] },
  { name: "attention_mask", data_type: TYPE_INT64, dims: [ -1, -1 ] }
]
parameters { key: "max_length", value: { string_value: "512" } }
instance_group [ { kind: KIND_CPU, count: 2 } ]
