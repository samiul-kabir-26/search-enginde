# Public embedder: INPUT_IMAGE BYTES [N] -> EMBEDDING FP32 [N, 512], L2-normalized (docs/MODELS.md §1).
name: "clip_image"
platform: "ensemble"
max_batch_size: 0
input [ { name: "INPUT_IMAGE", data_type: TYPE_STRING, dims: [ -1 ] } ]
output [ { name: "EMBEDDING", data_type: TYPE_FP32, dims: [ -1, 512 ] } ]
ensemble_scheduling {
  step [
    {
      model_name: "clip_image_pre"
      model_version: -1
      input_map { key: "INPUT_IMAGE", value: "INPUT_IMAGE" }
      output_map { key: "pixel_values", value: "pixel_values" }
    },
    {
      model_name: "clip_vision"
      model_version: -1
      input_map { key: "pixel_values", value: "pixel_values" }
      output_map { key: "EMBEDDING", value: "EMBEDDING" }
    }
  ]
}
