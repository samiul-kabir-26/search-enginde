      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stage latency p95 by provider",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage, provider) (rate(search_stage_duration_seconds_bucket{tenant=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} \u00b7 {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
